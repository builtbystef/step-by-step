# Copy to .env and load it into your shell before running the backend, the
# migration runner, or the integration tests:
#
#   set -a; source .env; set +a
#
# Every URL here reaches the compose stack over its published host ports, and
# nothing reads a connection URL from anywhere but the environment. The
# services inside the stack get their own values from compose.yaml, addressing
# each other by service name.
DATABASE_URL=postgresql+psycopg://stepbystep:stepbystep@localhost:5433/stepbystep
REDIS_URL=redis://localhost:6380/0

# Sandboxed coding agents cannot use the URLs above: their sandbox isolates
# the network namespace, so localhost TCP never reaches the stack. Postgres
# and Redis also answer on unix sockets that compose publishes into
# .dev/run/ — an agent (or anyone) swaps in these, with <repo> the absolute
# path of this checkout:
#
#   DATABASE_URL=postgresql+psycopg://stepbystep:stepbystep@/stepbystep?host=<repo>/.dev/run/pg
#   REDIS_URL=unix://<repo>/.dev/run/redis/redis.sock?db=0
#
# HTTP services (Garage, the containerised backend) answer the sandbox
# through its egress proxy at http://stack.local:3910 and :8001 — stack.local
# is an /etc/hosts alias for 127.0.0.1 that, unlike localhost, is not on the
# sandbox's NO_PROXY list. One-time host setup:
#
#   echo '127.0.0.1 stack.local' | sudo tee -a /etc/hosts

# The Artifact store. Two endpoints, not one: S3_ENDPOINT_URL is where a
# process reads and writes objects, and S3_PUBLIC_ENDPOINT is the address a
# presigned URL is signed for — the one the user's browser resolves. On the
# host they are the same; inside the stack they are not, because `garage` is a
# compose hostname no browser can reach. Signing with the internal endpoint
# passes every in-network test and breaks every real download.
S3_ENDPOINT_URL=http://localhost:3910
S3_PUBLIC_ENDPOINT=http://localhost:3910
S3_ACCESS_KEY_ID=stepbystep
S3_SECRET_ACCESS_KEY=stepbystepstepbystepstepbystep
S3_BUCKET=artifacts
S3_REGION=garage

# The vault's master key: base64 of 32 bytes, and the backend refuses to start
# without one that decodes to exactly that. The Workers never receive it (ADR
# 0004) — it is on the api service alone in compose.yaml, and it is here for
# the host backend `pnpm dev` runs. This is a dev key; generate a real one with
#
#   openssl rand -base64 32
#
# and keep it, because losing it makes every stored Secret and Auth State
# unrecoverable, by design.
STEPBYSTEP_MASTER_KEY=ZGV2LW9ubHkgbWFzdGVyIGtleSAtIG5ldmVyIHNoaXA=

# Shared Worker → backend token. Heartbeats (and later credential fetches)
# present it; without it those routes answer 401. The same value sits on
# both the api and worker services in compose.yaml. This is a dev default.
INTERNAL_TOKEN=dev-internal-token

# Shared VNC passwords. The backend proxy authenticates to each Worker's
# x11vnc with the view-only password unless the connecting session holds
# takeover. The same values sit on the api and worker services. VNC
# passwords are 8 characters; x11vnc truncates longer ones. Dev defaults.
VNC_CONTROL_PASSWORD=devctl01
VNC_VIEW_PASSWORD=devview1

# Where a host-run Worker POSTs heartbeats. Unset is right for the
# containerised Worker, which talks to http://api:8000 inside the network.
# API_URL=http://localhost:8000

# Who may sign up on this instance: `open`, or `invite_only`. Under `open`,
# verifying a Sign-in Code for an unknown address creates the account and an
# Organization owned by it. Under `invite_only` it does not, and new people
# join by Invitation instead — which is how an instance on the open internet
# stays yours. There is no instance administrator and no settings screen for
# this (ADR 0005); this variable is the whole control.
SIGNUP_MODE=open

# The instance default IANA timezone. A new Schedule's picker uses the
# browser's zone when this instance knows it, and this value otherwise.
# Unset is UTC.
# DEFAULT_TIMEZONE=UTC

# The mailer. Every email the product sends — the Sign-in Code and the
# Invitation — goes through one seam, and this picks what carries it:
#
#   console  the default: the message goes to the log, and to the in-process
#            outbox the seam tests read. No mail service, no account anywhere.
#   smtp     any relay or submission server. SMTP_HOST is required, the port
#            defaults to 587, and STARTTLS happens when the server offers it.
#            Set SMTP_USERNAME and SMTP_PASSWORD together or neither.
#   resend   the recommended hosted path. RESEND_API_KEY is required, and
#            MAIL_FROM must be an address on a domain Resend has verified.
#
# The backend refuses to start when the selected adapter's configuration is
# missing, naming the variable — a mailer that cannot send is found at boot
# rather than by the first person who asks for a Sign-in Code.
MAILER=console
MAIL_FROM=step-by-step@localhost
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# RESEND_API_KEY=

# Where the extension build this instance serves lives. Unset is right for the
# repository and for the backend image, which both keep it where the default
# looks — `apps/extension/src`. Point this somewhere else only if you pair a
# deployment with a build it did not come with.
# EXTENSION_DIR=
