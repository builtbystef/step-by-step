{
  "manifest_version": 3,
  "name": "Step by Step",
  "version": "0.1.0",
  "description": "Records what you do in the browser as a Step by Step Workflow.",
  "minimum_chrome_version": "118",
  "key": "",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "debugger",
    "webNavigation",
    "downloads",
    "cookies"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Step by Step",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
