{
  "openapi": "3.1.0",
  "info": {
    "title": "step-by-step-api",
    "version": "0.1.0"
  },
  "paths": {
    "/api/instance": {
      "get": {
        "summary": "Get Instance",
        "description": "The one fact the sign-in screen needs before anyone has signed in.",
        "operationId": "getInstance",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Instance"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/request-code": {
      "post": {
        "summary": "Request Signin Code",
        "description": "Mail a Sign-in Code to an address \u2014 202 whether or not it is anybody.\n\nThe answer must not vary with whether an account exists, or it becomes a\nway to ask which addresses are on this instance. So there is nothing in\nthe body to differ, and the caller learns what happened by entering a code.",
        "operationId": "requestSigninCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/verify-code": {
      "post": {
        "summary": "Verify Signin Code",
        "description": "Prove control of an address, which signs in \u2014 and signs up if it is new.",
        "operationId": "verifySigninCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedIn"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get Current Account",
        "description": "Who the caller is, and which Organizations they can act in.",
        "operationId": "getCurrentAccount",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/account": {
      "patch": {
        "summary": "Update Account",
        "description": "Change the display name. The email is the identity and is not editable.",
        "operationId": "updateAccount",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Sign Out",
        "description": "End this session \u2014 the row goes, and the browser stops carrying its key.\n\nOther sessions of the same user are untouched; ending all of them is the\nsession-expiry slice's `logout-all`.",
        "operationId": "signOut",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/workflows": {
      "post": {
        "summary": "Create Workflow",
        "description": "Make an empty Workflow in the acting Organization.\n\nIts Draft exists from this moment, empty: a recorder or an editor opening\na Workflow that has never been touched must find a document to write into\nrather than a missing row.",
        "operationId": "createWorkflow",
        "parameters": [
          {
            "name": "X-Organization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Organization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkflowCreation"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowSummary"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/workflows/{workflow_id}/draft": {
      "get": {
        "summary": "Get Workflow Draft",
        "description": "The Draft as one document: its Steps and the Variables they reference.",
        "operationId": "getWorkflowDraft",
        "parameters": [
          {
            "name": "workflow_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workflow Id"
            }
          },
          {
            "name": "X-Organization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Organization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowDocument"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Save Workflow Draft",
        "description": "Replace the Draft with the document sent, whole.\n\nWhole rather than patched: the editor holds the document it is editing, so\na save is a statement of what the Draft now is, and there is no order of\narrival in which two saves leave a Draft nobody wrote.",
        "operationId": "saveWorkflowDraft",
        "parameters": [
          {
            "name": "workflow_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workflow Id"
            }
          },
          {
            "name": "X-Organization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Organization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkflowDocument"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowDocument"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Get Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/hello/{name}": {
      "get": {
        "summary": "Get Greeting",
        "operationId": "getGreeting",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Greeting"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Account": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "orgs": {
            "items": {
              "$ref": "#/components/schemas/OrganizationMembership"
            },
            "type": "array",
            "title": "Orgs"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name",
          "orgs"
        ],
        "title": "Account",
        "description": "Who the caller is. The email is theirs as they typed it."
      },
      "AccountUpdate": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          }
        },
        "type": "object",
        "title": "AccountUpdate",
        "description": "The one thing about an account its owner may change here."
      },
      "CandidateKind": {
        "type": "string",
        "enum": [
          "testid",
          "role",
          "placeholder",
          "label",
          "alt",
          "text",
          "title",
          "css"
        ],
        "title": "CandidateKind",
        "description": "The ways of finding an element, in the order the recorder ranks them."
      },
      "ClickPayload": {
        "properties": {
          "target": {
            "$ref": "#/components/schemas/Target"
          },
          "assertedNavigation": {
            "type": "boolean",
            "title": "Assertednavigation",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target"
        ],
        "title": "ClickPayload"
      },
      "ClickStep": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "maxLength": 500,
            "title": "Label"
          },
          "optional": {
            "type": "boolean",
            "title": "Optional",
            "default": false
          },
          "disabled": {
            "type": "boolean",
            "title": "Disabled",
            "default": false
          },
          "screenshot": {
            "type": "boolean",
            "title": "Screenshot",
            "default": false
          },
          "timeoutMs": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Timeoutms"
          },
          "type": {
            "type": "string",
            "const": "click",
            "title": "Type"
          },
          "payload": {
            "$ref": "#/components/schemas/ClickPayload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "type",
          "payload"
        ],
        "title": "ClickStep"
      },
      "CodeRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+$",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "CodeRequest",
        "description": "Step one of the sign-in screen: the address to send a code to."
      },
      "DownloadPayload": {
        "properties": {
          "target": {
            "$ref": "#/components/schemas/Target"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target"
        ],
        "title": "DownloadPayload"
      },
      "DownloadStep": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "maxLength": 500,
            "title": "Label"
          },
          "optional": {
            "type": "boolean",
            "title": "Optional",
            "default": false
          },
          "disabled": {
            "type": "boolean",
            "title": "Disabled",
            "default": false
          },
          "screenshot": {
            "type": "boolean",
            "title": "Screenshot",
            "default": false
          },
          "timeoutMs": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Timeoutms"
          },
          "type": {
            "type": "string",
            "const": "download",
            "title": "Type"
          },
          "payload": {
            "$ref": "#/components/schemas/DownloadPayload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "type",
          "payload"
        ],
        "title": "DownloadStep"
      },
      "DurationWaitPayload": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "duration",
            "title": "Mode"
          },
          "durationMs": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Durationms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mode",
          "durationMs"
        ],
        "title": "DurationWaitPayload"
      },
      "ElementWaitPayload": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "element",
            "title": "Mode"
          },
          "target": {
            "$ref": "#/components/schemas/Target"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mode",
          "target"
        ],
        "title": "ElementWaitPayload"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "description": "What every refusal this application raises looks like."
      },
      "ExtractField": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "subSelector": {
            "type": "string",
            "title": "Subselector"
          },
          "attribute": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attribute"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "subSelector"
        ],
        "title": "ExtractField",
        "description": "One column of a list extraction, bound within the repeating element."
      },
      "ExtractStep": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "maxLength": 500,
            "title": "Label"
          },
          "optional": {
            "type": "boolean",
            "title": "Optional",
            "default": false
          },
          "disabled": {
            "type": "boolean",
            "title": "Disabled",
            "default": false
          },
          "screenshot": {
            "type": "boolean",
            "title": "Screenshot",
            "default": false
          },
          "timeoutMs": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Timeoutms"
          },
          "type": {
            "type": "string",
            "const": "extract",
            "title": "Type"
          },
          "payload": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ScalarExtractPayload"
              },
              {
                "$ref": "#/components/schemas/ListExtractPayload"
              }
            ],
            "title": "Payload",
            "discriminator": {
              "propertyName": "mode",
              "mapping": {
                "list": "#/components/schemas/ListExtractPayload",
                "scalar": "#/components/schemas/ScalarExtractPayload"
              }
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "type",
          "payload"
        ],
        "title": "ExtractStep"
      },
      "FrameHop": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index"
        ],
        "title": "FrameHop",
        "description": "One step of the path into the frame an element lives in."
      },
      "Greeting": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "Greeting"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "Instance": {
        "properties": {
          "signup_mode": {
            "$ref": "#/components/schemas/SignupMode"
          }
        },
        "type": "object",
        "required": [
          "signup_mode"
        ],
        "title": "Instance",
        "description": "What an unauthenticated visitor may learn about this instance."
      },
      "ListExtractPayload": {
        "properties": {
          "target": {
            "$ref": "#/components/schemas/Target"
          },
          "outputName": {
            "type": "string",
            "title": "Outputname"
          },
          "mode": {
            "type": "string",
            "const": "list",
            "title": "Mode"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/ExtractField"
